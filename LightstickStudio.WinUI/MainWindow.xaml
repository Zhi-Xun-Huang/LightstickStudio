<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LightstickStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Lightstick Studio">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="14">
        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="ActivePresetButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Image Source="ms-appx:///icon/logo.png" Width="170" Height="60"
                       Stretch="Uniform" VerticalAlignment="Center"
                       AutomationProperties.Name="致予新世界演唱會 Logo" />
                <StackPanel>
                    <TextBlock Text="Lightstick Studio" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="鳴潮演唱會燈棒控制台 · WinUI 3" Opacity="0.68" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="DeviceInfoBar" Grid.Row="1" IsOpen="True" IsClosable="False"
                 Severity="Informational" Title="正在啟動背景控制引擎…" />

        <TabView Grid.Row="2" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
            <TabViewItem Header="即時控制" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="0,12,12,12">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="快速模式" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SteadyPresetButton" Content="恆亮" Tag="steady" Click="PresetButton_Click" Style="{StaticResource PresetButtonStyle}" />
                                    <Button x:Name="BreathingPresetButton" Content="呼吸燈" Tag="breathing" Click="PresetButton_Click" Style="{StaticResource PresetButtonStyle}" />
                                    <Button x:Name="BlinkPresetButton" Content="閃爍" Tag="blink" Click="PresetButton_Click" Style="{StaticResource PresetButtonStyle}" />
                                    <Button x:Name="RainbowPresetButton" Content="七彩循環" Tag="rainbow" Click="PresetButton_Click" Style="{StaticResource PresetButtonStyle}" />
                                    <Button x:Name="AudioPresetButton" Content="音樂律動" Tag="audio" Click="PresetButton_Click" Style="{StaticResource PresetButtonStyle}" />
                                    <Button x:Name="ScreenPresetButton" Content="畫面同步" Tag="screen" Click="PresetButton_Click" Style="{StaticResource PresetButtonStyle}" />
                                    <Button x:Name="ConcertPresetButton" Content="演唱會同步" Tag="concert" Click="PresetButton_Click" Style="{StaticResource PresetButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="顏色來源" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <RadioButton x:Name="SolidColorRadio" Content="固定顏色" GroupName="ColorSource" Tag="solid" Click="SourceChanged" />
                                        <RadioButton x:Name="ScreenColorRadio" Content="畫面同步" GroupName="ColorSource" Tag="screen" IsChecked="True" Click="SourceChanged" />
                                        <RadioButton x:Name="RainbowColorRadio" Content="七彩循環" GroupName="ColorSource" Tag="rainbow" Click="SourceChanged" />
                                    </StackPanel>
                                    <StackPanel x:Name="SolidColorControls" Orientation="Horizontal" Spacing="8">
                                        <Border x:Name="SolidColorSwatch" Width="44" Height="32" CornerRadius="6" Background="#FFFF2040" />
                                        <TextBox x:Name="SolidColorBox" Text="#FF2040" Width="110" TextChanged="SolidColorBox_TextChanged" />
                                        <Button Content="選色" Click="ChooseColorButton_Click" />
                                        <Button x:Name="EyedropperButton" Content="滴管" Click="EyedropperButton_Click" />
                                    </StackPanel>
                                    <StackPanel x:Name="TestColorControls" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="快速試色" VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <Button Content="白" Tag="#FFFFFF" Click="TestColorButton_Click" />
                                        <Button Content="紅" Tag="#FF0000" Click="TestColorButton_Click" />
                                        <Button Content="綠" Tag="#00FF00" Click="TestColorButton_Click" />
                                        <Button Content="藍" Tag="#0000FF" Click="TestColorButton_Click" />
                                        <Button Content="紫" Tag="#B000FF" Click="TestColorButton_Click" />
                                        <Button Content="熄燈" Tag="#000000" Click="TestColorButton_Click" />
                                    </StackPanel>
                                    <Grid x:Name="RainbowSpeedControls" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="循環速度" VerticalAlignment="Center" />
                                        <Slider x:Name="RainbowSpeedSlider" Grid.Column="1" Minimum="0.02" Maximum="0.5" Value="0.1" StepFrequency="0.01" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="亮度來源" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <RadioButton x:Name="FixedBrightnessRadio" Content="固定亮度" GroupName="BrightnessSource" Tag="fixed" Click="SourceChanged" />
                                        <RadioButton x:Name="AudioBrightnessRadio" Content="音樂律動" GroupName="BrightnessSource" Tag="audio" IsChecked="True" Click="SourceChanged" />
                                    </StackPanel>
                                    <Grid x:Name="FixedBrightnessControls" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="固定亮度" VerticalAlignment="Center" />
                                        <Slider x:Name="FixedBrightnessSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.75" StepFrequency="0.01" ValueChanged="FixedBrightnessSlider_ValueChanged" />
                                        <TextBlock x:Name="FixedBrightnessText" Grid.Column="2" Text="75%" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="音樂律動的靈敏度與門檻可在「畫面與音訊」調整。" TextWrapping="Wrap" Opacity="0.68" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="即時輸出" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Border x:Name="OutputSwatch" Height="105" CornerRadius="10" Background="Black" />
                                <Grid>
                                    <TextBlock x:Name="OutputHexText" Text="#000000" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OutputDetailText" Text="RGB 0, 0, 0 · 亮度 0%" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.68" />
                                    <TextBlock x:Name="AudioDeviceText" Text="系統預設輸出" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.68" />
                                </Grid>
                                <ProgressBar x:Name="AudioMeter" Minimum="0" Maximum="100" Value="0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="StartButton" Content="開始控制" Style="{StaticResource AccentButtonStyle}" Click="StartButton_Click" />
                            <Button x:Name="StopButton" Content="停止並熄燈" IsEnabled="False" Click="StopButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="畫面與音訊" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid ColumnSpacing="14" Padding="0,12,12,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="畫面同步" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ComboBox x:Name="MonitorCombo" Header="採樣來源" SelectedIndex="0" SelectionChanged="MonitorCombo_SelectionChanged">
                                    <ComboBoxItem Content="顯示器 1（完整畫面）" />
                                </ComboBox>
                                <TextBlock x:Name="RegionText" Text="請選擇顯示器或目前開啟的視窗" Opacity="0.68" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="重新整理視窗" Click="RefreshWindowsButton_Click" />
                                    <Button Content="使用整個顯示器" Click="ClearRegionButton_Click" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="控制畫面顏色跟隨速度。數值低會較平穩但反應較慢；數值高會更即時，但可能容易跳色。">
                                    <TextBlock Text="畫面平滑度" />
                                    <Slider x:Name="SmoothingSlider" Minimum="0.05" Maximum="0.8" Value="0.24" StepFrequency="0.01" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="提高從畫面擷取到的整體色彩飽和度，減少舞台白光把顏色沖淡。0 為不額外強化，1 為最強。">
                                    <TextBlock Text="整體彩度" />
                                    <Slider x:Name="ColorBoostSlider" Minimum="0" Maximum="1" Value="0.38" StepFrequency="0.01" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="針對偏橘或偏粉的紅色進行飽和度與色相修正。0 為關閉，1 為最強。">
                                    <TextBlock Text="紅色強化" />
                                    <Slider x:Name="RedBoostSlider" Minimum="0" Maximum="1" Value="0.72" StepFrequency="0.01" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="減少舞台黃光、白光對綠色的干擾，讓綠色更鮮明。0 為關閉，1 為最強。">
                                    <TextBlock Text="綠色強化" />
                                    <Slider x:Name="GreenBoostSlider" Minimum="0" Maximum="1" Value="0.72" StepFrequency="0.01" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="額外強化藍色區域。這支燈棒的藍色原本已很明顯，通常維持 0 即可。">
                                    <TextBlock Text="藍色強化" />
                                    <Slider x:Name="BlueBoostSlider" Minimum="0" Maximum="1" Value="0" StepFrequency="0.01" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="音樂律動" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Windows 系統預設輸出（WASAPI Loopback）" Opacity="0.68" />
                                <StackPanel ToolTipService.ToolTip="放大電腦音訊的強弱變化。數值越高，較小的聲音也能讓燈棒明顯變亮。">
                                    <TextBlock Text="靈敏度" />
                                    <Slider x:Name="SensitivitySlider" Minimum="0.1" Maximum="4" Value="1.35" StepFrequency="0.05" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="低於此音量的聲音會視為靜音，可過濾底噪。調太高可能漏掉較安靜的音樂。">
                                    <TextBlock Text="靜音門檻" />
                                    <Slider x:Name="AudioGateSlider" Minimum="0" Maximum="0.5" Value="0.08" StepFrequency="0.01" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="控制強拍與弱拍的亮度差。大於 1 會壓低弱音、突出節拍；接近 4 時只保留很強的節拍，小於 1 會讓燈光較持續。">
                                    <TextBlock Text="節拍對比" />
                                    <Slider x:Name="GammaSlider" Minimum="0.5" Maximum="4" Value="1.35" StepFrequency="0.05" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="沒有聲音時仍保留的基礎亮度。設為 0 時，靜音便會完全熄燈。">
                                    <TextBlock Text="最低亮度" />
                                    <Slider x:Name="MinimumSlider" Minimum="0" Maximum="1" Value="0" StepFrequency="0.01" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="限制最強音量時的最高亮度。降低可減少刺眼程度並延長電池使用時間。">
                                    <TextBlock Text="最高亮度" />
                                    <Slider x:Name="MaximumSlider" Minimum="0" Maximum="1" Value="1" StepFrequency="0.01" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                                <StackPanel ToolTipService.ToolTip="每秒分析畫面並傳送顏色的次數。較高更流暢但增加電腦、USB 與射頻負擔。">
                                    <TextBlock Text="更新 FPS" />
                                    <Slider x:Name="FpsSlider" Minimum="10" Maximum="30" Value="25" StepFrequency="1" ValueChanged="Slider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="發射器韌體" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="0,12,12,12">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="XIAO nRF52840 Plus" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="FirmwareStatusText" Text="正在檢查 XIAO…" />
                                <TextBlock Text="內附韌體：JFKJ_LIGHTSTICK_TX_V1（UF2）&#x0a;只更新 application，不修改 Bootloader、SoftDevice 或 UICR。" TextWrapping="Wrap" Opacity="0.68" />
                                <Button x:Name="FlashButton" Content="安裝／更新燈棒控制韌體" Style="{StaticResource AccentButtonStyle}" Click="FlashButton_Click" HorizontalAlignment="Left" />
                                <ProgressBar x:Name="FirmwareProgress" Minimum="0" Maximum="100" Value="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="關於" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="0,12,12,12">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="22">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Image Source="ms-appx:///icon/logo.png" Width="160" Height="56"
                                           Stretch="Uniform" VerticalAlignment="Center"
                                           AutomationProperties.Name="致予新世界演唱會 Logo" />
                                    <StackPanel>
                                        <TextBlock Text="Lightstick Studio" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="AboutVersionText" Text="版本資訊讀取中…" Opacity="0.68" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="為鳴潮演唱會燈棒打造的非官方控制工具，透過 XIAO nRF52840 發射器提供燈效、音樂律動與畫面同步功能。"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="22">
                            <StackPanel Spacing="8">
                                <TextBlock Text="著作權與使用聲明" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Copyright © 2026 Zhi-Xun-Huang."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="本專案為非官方社群研究成果，與遊戲發行商、演唱會主辦單位及燈棒製造商均無隸屬或合作關係。相關名稱、商標及作品之權利歸各自權利人所有。"
                                           TextWrapping="Wrap" Opacity="0.72" />
                                <TextBlock Text="Lightstick Studio 原始碼以 MIT License 授權；第三方元件仍適用各自的授權條款。"
                                           TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="22">
                            <StackPanel Spacing="8">
                                <TextBlock Text="特別致謝" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="特別感謝 OpenAI Codex，在通訊協定逆向分析、發射器韌體、Lightstick Studio 介面設計與除錯過程中提供協作支援。"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="也感謝所有參與測試、記錄燈效與分享研究成果的貢獻者。"
                                           TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
