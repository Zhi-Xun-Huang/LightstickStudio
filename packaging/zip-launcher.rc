#define STRINGIFY_INNER(x) #x
#define STRINGIFY(x) STRINGIFY_INNER(x)
#define VERSION_TEXT STRINGIFY(STUDIO_MAJOR) "." STRINGIFY(STUDIO_MINOR) "." STRINGIFY(STUDIO_PATCH)

1 ICON "icon/app.ico"

1 VERSIONINFO
FILEVERSION STUDIO_MAJOR,STUDIO_MINOR,STUDIO_PATCH,0
PRODUCTVERSION STUDIO_MAJOR,STUDIO_MINOR,STUDIO_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Zhi-Xun-Huang"
            VALUE "FileDescription", "Lightstick Studio portable launcher"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "LegalCopyright", "Copyright (c) 2026 Zhi-Xun-Huang"
            VALUE "OriginalFilename", "LightstickStudio.WinUI.exe"
            VALUE "ProductName", "Lightstick Studio"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
